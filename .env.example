# Sites deployment prepares this server-only Secret once. Preserve it on later deployments.
# Local Worker preview: set a separate base64-encoded random 32-byte key in ignored .dev.vars.
AI_SETTINGS_ENCRYPTION_KEY=
# Server-only owner configuration. Use the Site's verified owner email for a one-time
# binding to the real Site-specific login ID; never grant owner to the first visitor.
APP_OWNER_EMAIL=
# Optional explicit Site-specific identity; do not substitute a global account UUID.
APP_OWNER_USER_ID=
# Personal MiniMax API keys, models and regions are configured at /settings/ai.
