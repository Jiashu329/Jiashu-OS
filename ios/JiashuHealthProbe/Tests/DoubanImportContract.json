    {
      "name": "Exactly 500 input rows across files pass before deduplication",
      "files": [
        {"name": "one.json", "repeatRows": 250, "input": [{"title": "重复作品", "url": "https://book.douban.com/subject/4001/", "state": "读过"}]},
        {"name": "two.json", "repeatRows": 250, "input": [{"title": "重复作品", "url": "https://book.douban.com/subject/4001/", "state": "读过"}]}
      ],
      "expected": {"subjects": ["4001"], "skipped": 0, "duplicates": 499}
    },
    {
      "name": "Across-file row limit counts duplicates and skipped rows",
      "files": [
        {"name": "one.json", "repeatRows": 250, "input": [{"title": "重复作品", "url": "https://book.douban.com/subject/4001/", "state": "读过"}]},
        {"name": "two.json", "repeatRows": 251, "input": [{"title": "想读作品", "url": "https://book.douban.com/subject/4002/", "state": "想读"}]}
      ],
