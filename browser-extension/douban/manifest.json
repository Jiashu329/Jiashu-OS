{
  "manifest_version": 3,
  "name": "Jiashu OS 豆瓣同步",
  "version": "1.0.5",
  "description": "由你在 Jiashu OS 点击同步，沿用本机豆瓣登录状态读取已完成收藏。不会读取或上传登录凭据。",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://movie.douban.com/*",
    "https://book.douban.com/*",
    "https://music.douban.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://jiashu-life-os-health.jiashuh329.chatgpt.site/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
