{
  "name": "jiashu-life-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-release.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:production": "node scripts/run-tests.mjs production",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/release-check.mjs",
    "release:check": "node scripts/release-check.mjs --release",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "markdown-it": "^15.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "linkedom": "^0.18.15",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
